# Code Chat Viewer - .gitignore
# Created by Óscar González Martín

# === Python ===
# Compiled Python files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Type checkers and linters
.mypy_cache/
.pytest_cache/
.coverage
*.cover

# === IDEs, Editors ===
# VSCode
.vscode/
*.code-workspace

# Claude Code
.claude/

# PyCharm
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# === Operating Systems ===
# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# === Project Specific ===
# Generated HTML files (chat exports + dashboard)
*.html

# Screenshot / demo assets (generated locally for the README and releases; not tracked)
/screenshots/

# Test files and outputs (generated during development)
test_*.json
sample_*.json

# Development folders
debug/
tmp/
temp/

# Backup files
*.bak
*.backup
*.tmp
*.orig

# Claude Code temp files
tmpclaude-*

# User configuration (generated by setup, contains personal paths)
config.json

# Local customization assets (embedded into the dashboard when present;
# personal tweaks live here and never reach the public repo)
custom/

# === Internal documentation system (private) ===
# This is a PUBLIC repo: only its public face is tracked.
# Kept PUBLIC on purpose: README.md, LICENSE, CONTRIBUTING.md, CODE_OF_CONDUCT.md,
# SKILL.md, tests/README.md, config.example.json, .gitattributes, icon.png, assets/
# Core internal docs (state, backlog, context, notes)
CLAUDE.md
REGISTRO.md
REGISTRO_*.md
PENDIENTES.md
NOTES.md
NOTAS.md
TODO.md
INSTRUCCIONES.md
SLIPKNOT.md
# Development-layer internal docs
DECISIONS.md
LEARNINGS.md
COMMANDS.md
DEPLOY.md
BRANDING.md
# Transitory docs (plans, scripts, audits, certifications, investigations, reports)
PLAN_*.md
GUION_*.md
AUDIT_*.md
CERT_*.md
CONTROL_*
INV_*.md
INF_*.md
# Documentation-system folders
Configuraciones/
Incidencias/
Informes/
# Catch-all for anything private that fits no pattern above
privado/
# Drafts
*.draft

# Distribution archives
*.zip
*.tar.gz
*.rar
*.7z

# Logs
*.log
logs/

# === Security ===
# Secrets and credentials
secrets.json
.secrets
credentials.json
*.key
*.pem
*.cert
.env.local
.env.*.local
